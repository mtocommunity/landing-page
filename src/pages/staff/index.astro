import LeaderCard from "../../components/landing/molecule/leader_card";
import HistoricalStaffCard from "../../components/landing/molecule/HistoricalStaffCard.astro";
import Layout from "../../layouts/landing/index.astro";
import "./_style.css";
---

<Layout title="MTO Staff">
  <main
    class="flex flex-col w-full overflow-x-hidden min-h-dvh items-center pb-24 text-white bg-gradient-to-tr from-mto_blue/10 lg:via-mto_dark_gray"
  >
    <div class="absolute opacity-25 -z-20 bg-grid-container">
      <div class="bg-grid"></div>
    </div>
    <div
      class="bg-gradient-to-bl from-mto_dark_gray via-mto_blue/20 from-0% to-mto_dark_gray to-40% aspect-square -z-30 absolute left-0 top-0 h-[100dvh] w-full"
    >
    </div>
    <div class="flex flex-col pt-32 gap-4 items-center text-white">
      <h1 class="text-3xl font-main_sans font-bold">Staff</h1>
      <p class="px-4 lg:w-1/2 text-center font-lora">
        Conoce al equipo que hace esto posible.<br /> Detrás de cada evento, iniciativa
        y proyecto hay un equipo de personas comprometidas con crear un espacio donde
        aprender, innovar y colaborar sea una experiencia increíble.
      </p>
    </div>

    <!-- Community Leads -->
    <p
      class="font-main_sans text-2xl mb-10 md:text-2xl lg:text-3xl lg:mb-10 lg:p-8"
    >
      Líderes de la Comunidad
    </p>
    <div
      class="flex flex-wrap justify-center gap-8 px-8 justify-items-center lg:gap-x-16 mb-10"
    >
      <LeaderCard
        photo="https://cdn.mtocommunity.com/staff-julian-acosta.webp"
        name="Julián Acosta"
        role="Líder de la Comunidad"
        link="https://www.instagram.com/juliancacosta"
      />
    </div>

    <!-- Teams leaders -->
    <p
      class="text-xl md:text-2xl lg:text-3xl p-8 lg:gap-16 mb-6 font-main_sans"
    >
      Líderes de Equipos
    </p>
    <div
      class="lg:py-6 flex flex-wrap gap-y-8 gap-x-16 px-8 justify-items-center justify-center lg:gap-x-16 xl:gap-x-32"
    >
    </div>

    <!-- Social Media -->
    <p
      class="text-xl md:text-2xl lg:text-3xl p-8 lg:gap-16 mb-6 font-main_sans"
    >
      Social Media Team
    </p>
    <div
      class="lg:py-6 flex flex-wrap gap-y-8 gap-x-16 px-8 justify-items-center justify-center lg:gap-x-32 xl:gap-x-32"
    >
      <LeaderCard
        photo="https://cdn.mtocommunity.com/staff-matamitas.jpg"
        name="Cristhoper Cueva"
        role="Líder & Edición"
        link="https://www.instagram.com/matamitas25/"
      />
      <LeaderCard
        photo="https://cdn.mtocommunity.com/staff-jaris-alday.png"
        name="Jaris Alday"
        role="Embajadora de la Comunidad"
        link="https://www.instagram.com/taehyrthv"
      />
      <LeaderCard
        photo="https://cdn.mtocommunity.com/staff-joselin-bances.webp"
        name="Joselin Bances"
        role="Imagen de la Comunidad"
        easter_egg="Reprobó IVU pero shh..."
        link="https://www.instagram.com/josi30_b.a"
      />
      <LeaderCard
        photo="https://cdn.mtocommunity.com/staff-mariela-campos.webp"
        name="Mariela Campos"
        role="Fotografía"
        easter_egg="Camara Woman"
        link="https://www.instagram.com/alixxcam"
      />
    </div>

    <!-- Logistic Team -->
    <p
      class="text-xl md:text-2xl lg:text-3xl p-8 lg:gap-16 mb-6 font-main_sans"
    >
      Equipo de Logística
    </p>
    <div
      class="lg:py-6 flex flex-wrap gap-y-8 gap-x-16 px-8 justify-items-center justify-center lg:gap-x-16 xl:gap-x-32"
    >
      <LeaderCard
        photo="https://cdn.mtocommunity.com/staff-daniel-mendoza.jpeg"
        name="Daniel Mendoza"
        role="Responsable de Logística"
        link="https://www.instagram.com/da_mz21/"
      />
      <LeaderCard
        photo="https://cdn.mtocommunity.com/staff-jorge-gil.jpeg"
        name="Jorge Asencio"
        role="Staff de Logística"
        easter_egg="Gerente de asuntos sin importancia"
        link="https://www.linkedin.com/in/jorge-ascencio-gil-450240337/"
      />
    </div>

    <!-- Historical Staff -->
    <section class="mt-16 w-full px-8 flex flex-col items-center">
      <h2 class="text-xl md:text-2xl lg:text-3xl mb-3 font-main_sans">
        Staff histórico
      </h2>
      <p class="mb-8 max-w-2xl text-center font-lora text-white/70">
        Personas que también formaron parte de la historia de nuestra comunidad.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <HistoricalStaffCard
          photo="https://cdn.mtocommunity.com/staff-luis-bazan-rios.jpg"
          name="Luis Bazán"
          link="http://instagram.com/luis.brios"
        />
        <HistoricalStaffCard
          photo="https://cdn.mtocommunity.com/staff-junior-delgado-flores.jpg"
          name="Junior Delgado"
          link="https://github.com/aarondfv"
        />
        <HistoricalStaffCard
          photo="https://cdn.mtocommunity.com/staff-jorge-contreras-delgado.jpg"
          name="Jorge Contreras"
          link="https://jorgecode.studio"
        />
        <HistoricalStaffCard
          photo="https://cdn.mtocommunity.com/staff-juan-romero.jpg"
          name="Juan Romero"
          link="https://linktr.ee/IngSystemCix"
        />
        <HistoricalStaffCard
          photo="https://cdn.mtocommunity.com/staff-eliana-cajusol.jpg"
          name="Eliana Cajusol"
          link="https://www.linkedin.com/in/eliana-cajusol-acosta-b64a3027b"
        />
        <HistoricalStaffCard
          photo="https://cdn.mtocommunity.com/staff-abner-cubas-parra.jpg"
          name="Abner Cubas"
          link="http://www.linkedin.com/in/abner-cubas-parra-176a7329a"
        />
        <HistoricalStaffCard
          photo="https://cdn.mtocommunity.com/staff-victor-tunoque.png"
          name="Víctor Tuñoque"
          link="https://www.linkedin.com/in/víctor-vladimir-tuñoque-morante-6a89072a2"
        />
        <HistoricalStaffCard
          photo="https://cdn.mtocommunity.com/staff-jaime-lopez.jpg"
          name="Jaime López"
          link="#"
        />
        <HistoricalStaffCard
          photo="https://cdn.mtocommunity.com/staff-briggitte-martinez-vidaurre.jpg"
          name="Briggitte Martinez"
          link="https://www.instagram.com/briggittemar_v"
        />
        <HistoricalStaffCard
          photo="https://cdn.mtocommunity.com/staff-lenin-castaneda.jpg"
          name="Lenin Castañeda"
          link="https://www.linkedin.com/in/lenin-alexander-casta%C3%B1eda-aguilar-68a79b299/"
        />
        <HistoricalStaffCard
          photo="https://cdn.mtocommunity.com/staff-wilder-cubas.webp"
          name="Wilder Cubas"
          link="https://www.instagram.com/w.m.c.h.lu"
        />
        <HistoricalStaffCard
          photo="https://cdn.mtocommunity.com/staff-paul-campos.webp"
          name="Paul Campos"
          link="https://www.linkedin.com/in/akidev"
        />
      </div>
    </section>
  </main>
</Layout>
